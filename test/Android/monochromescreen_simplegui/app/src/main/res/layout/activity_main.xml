<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101010"
    android:orientation="vertical">

    <!-- 上半部分：点阵屏画布 -->
    <cn.hyhsystem.hcppbox.monochromesimplegui.ScreenCanvasView
        android:id="@+id/screen_canvas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="8dp"
        android:layout_weight="1"
        android:background="#FF000000" />

    <!-- 下半部分：键盘 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF1E1E1E"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- 第一排：F1、F2、F3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button_f1"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:focusable="false"
                android:text="@string/key_f1"
                android:textSize="16sp" />

            <Button
                android:id="@+id/button_f2"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:focusable="false"
                android:text="@string/key_f2"
                android:textSize="16sp" />

            <Button
                android:id="@+id/button_f3"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:focusable="false"
                android:text="@string/key_f3"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- 第二排：确定、切换、取消 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button_ok"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:focusable="false"
                android:text="@string/key_ok"
                android:textSize="16sp" />

            <Button
                android:id="@+id/button_tab"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:focusable="false"
                android:text="@string/key_tab"
                android:textSize="16sp" />

            <Button
                android:id="@+id/button_cancel"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:focusable="false"
                android:text="@string/key_cancel"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- 方向键：十字排列 -->
        <GridLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:columnCount="3">

            <Space
                android:layout_width="64dp"
                android:layout_height="44dp" />

            <Button
                android:id="@+id/button_up"
                android:layout_width="64dp"
                android:layout_height="44dp"
                android:layout_margin="2dp"
                android:focusable="false"
                android:text="@string/key_up"
                android:textSize="18sp" />

            <Space
                android:layout_width="64dp"
                android:layout_height="44dp" />

            <Button
                android:id="@+id/button_left"
                android:layout_width="64dp"
                android:layout_height="44dp"
                android:layout_margin="2dp"
                android:focusable="false"
                android:text="@string/key_left"
                android:textSize="18sp" />

            <Space
                android:layout_width="64dp"
                android:layout_height="44dp" />

            <Button
                android:id="@+id/button_right"
                android:layout_width="64dp"
                android:layout_height="44dp"
                android:layout_margin="2dp"
                android:focusable="false"
                android:text="@string/key_right"
                android:textSize="18sp" />

            <Space
                android:layout_width="64dp"
                android:layout_height="44dp" />

            <Button
                android:id="@+id/button_down"
                android:layout_width="64dp"
                android:layout_height="44dp"
                android:layout_margin="2dp"
                android:focusable="false"
                android:text="@string/key_down"
                android:textSize="18sp" />

            <Space
                android:layout_width="64dp"
                android:layout_height="44dp" />
        </GridLayout>
    </LinearLayout>

</LinearLayout>
